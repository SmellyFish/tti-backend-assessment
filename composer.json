{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nikita-makeyev/pro-api",
    "type": "project",
    "description": "Patient Reported Outcomes (PRO) API built with Laravel, MySQL, and Docker.",
    "keywords": [
        "laravel",
        "pro",
        "patient-reported-outcomes",
        "healthcare",
        "api",
        "mysql",
        "docker"
    ],
    "homepage": "https://github.com/SmellyFish/tti-backend-assessment",
    "support": {
        "issues": "https://github.com/SmellyFish/tti-backend-assessment/issues",
        "source": "https://github.com/SmellyFish/tti-backend-assessment"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/SmellyFish/tti-backend-assessment.git"
        }
    ],
    "authors": [
        {
            "name": "Nikita Makeyev"
        }
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^11.31",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.9"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "league/openapi-psr7-validator": "^0.22.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "nyholm/psr7": "^1.8",
        "phpunit/phpunit": "^11.0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
